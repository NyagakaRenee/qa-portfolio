  "item": [
    {
      "name": "1. Read (GET) - positive tests",
      "item": [
        {
          "name": "GET all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time is under 2000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "pm.test(\"Content-Type is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Body is an array of 100 posts\", function () { const j = pm.response.json(); pm.expect(j).to.be.an(\"array\"); pm.expect(j.length).to.eql(100); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Happy path: list all posts."
          },
          "response": []
        },
        {
          "name": "GET single post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time is under 2000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "pm.test(\"Content-Type is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Post 1 has the expected fields\", function () { const j = pm.response.json(); pm.expect(j).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\"); });",
                  "pm.test(\"id is 1 and field types are correct\", function () { const j = pm.response.json(); pm.expect(j.id).to.eql(1); pm.expect(j.userId).to.be.a(\"number\"); pm.expect(j.title).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "description": "Happy path: fetch one post and validate its schema."
          },
          "response": []
        },
        {
          "name": "GET posts filtered by userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Every returned post belongs to userId 1\", function () { const j = pm.response.json(); pm.expect(j).to.be.an(\"array\").that.is.not.empty; j.forEach(p => pm.expect(p.userId).to.eql(1)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            },
            "description": "Query-parameter filtering."
          },
          "response": []
        },
        {
          "name": "GET comments for a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Comments are linked to post 1\", function () { pm.response.json().forEach(c => pm.expect(c.postId).to.eql(1)); });",
                  "pm.test(\"Every comment has a valid email format\", function () { const re = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/; pm.response.json().forEach(c => pm.expect(c.email).to.match(re)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1",
                "comments"
              ]
            },
            "description": "Nested resource plus data-format validation."
          },
          "response": []
        },
        {
          "name": "GET single user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response has an email field\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.have.property(\"email\");\r\n});\r\npm.test(\"Email contains an @ symbol\", function () {\r\n    pm.expect(pm.response.json().email).to.include(\"@\");\r\n});\r\npm.test(\"Address has a city\", function () {\r\n    pm.expect(pm.response.json().address.city).to.be.a(\"string\").and.not.empty;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
