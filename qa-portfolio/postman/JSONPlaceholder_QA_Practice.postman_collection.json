    {
      "name": "2. Create / Update / Delete",
      "item": [
        {
          "name": "POST create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Content-Type is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Response echoes the data sent\", function () { const j = pm.response.json(); pm.expect(j.title).to.eql(\"QA practice post\"); pm.expect(j.userId).to.eql(1); });",
                  "pm.test(\"A new id is returned\", function () { const j = pm.response.json(); pm.expect(j.id).to.be.a(\"number\"); pm.collectionVariables.set(\"newPostId\", j.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA practice post\",\n  \"body\": \"Created from a Postman test\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Create a resource and store its id in a collection variable."
